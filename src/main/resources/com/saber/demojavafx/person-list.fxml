<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.saber.demojavafx.controllers.PersonController"
            nodeOrientation="RIGHT_TO_LEFT">

    <center>
        <StackPane>
            <VBox spacing="15"
                  maxWidth="1200"
                  maxHeight="700"
                  alignment="TOP_CENTER"
                  styleClass="content-box">
                <!-- عنوان -->
                <Label text="لیست اشخاص"
                       styleClass="page-title"/>
                <!-- بخش جستجو -->
                <HBox spacing="10"
                      alignment="CENTER_LEFT">
                    <TextField promptText="جستجوی شخص..."
                               fx:id="searchField"
                               prefWidth="300"/>
                    <Button text="جستجو" fx:id="buttonSearch" />
                    <Button text="شخص جدید"
                            fx:id="buttonNewPerson"/>
                </HBox>
                <!-- جدول -->
                <TableView fx:id="personTable"
                           prefWidth="1200"
                           prefHeight="600"
                           VBox.vgrow="ALWAYS">

                    <!-- جلوگیری از Scroll افقی -->
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="idColumn"
                                     text="شناسه"
                                     prefWidth="100"/>
                        <TableColumn fx:id="firstnameColumn"
                                     text="نام"
                                     prefWidth="120"/>
                        <TableColumn fx:id="lastnameColumn"
                                     text="نام خانوادگی"
                                     prefWidth="150"/>
                        <TableColumn fx:id="ageColumn"
                                     text="سن"
                        />
                        <TableColumn fx:id="mobileColumn"
                                     text="موبایل"
                                     prefWidth="130"/>
                        <TableColumn fx:id="nationalCodeColumn"
                                     text="کد ملی"
                                     prefWidth="130"/>
                        <TableColumn fx:id="emailColumn"
                                     text="پست الکترونیک"
                                     prefWidth="200"/>
                        <TableColumn fx:id="actionColumn"
                                     text="عملیات"
                                     prefWidth="250"/>
                    </columns>
                </TableView>
                <Pagination fx:id="pagination"
                            pageCount="1"
                />
            </VBox>
        </StackPane>
    </center>
</BorderPane>