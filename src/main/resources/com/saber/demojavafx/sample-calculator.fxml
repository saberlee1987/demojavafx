<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.saber.demojavafx.controllers.SampleCalculatorController"
            prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="15" bottom="15" left="15" right="15"/>
    </padding>
    
    <top>
        <HBox alignment="CENTER_RIGHT">
            <Label>
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
               ماشین حساب
            </Label>
        </HBox>
    </top>
    <center>
        <GridPane hgap="15" vgap="15" nodeOrientation="RIGHT_TO_LEFT">
            <TextField GridPane.columnIndex="0"
                   GridPane.rowIndex="0"
            fx:id="textFieldNumber1">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </TextField>
            <TextField GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       fx:id="textFieldNumber2"
            />
            <ComboBox GridPane.columnIndex="0"
                      GridPane.rowIndex="2"
                      fx:id="operators"/>
            
            <Label GridPane.columnIndex="0"
                   GridPane.rowIndex="3"
            fx:id="result">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Label>
        </GridPane>
    </center>
    
    <bottom>
        <HBox alignment="CENTER"><Label>
            <font>
                <Font name="System Bold" size="16"/>
            </font>
           توسعه دهنده : صابر عزیزی </Label>
        </HBox>
    </bottom>

</BorderPane>
